# MedCorpus AI Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Security / JWT
SECRET_KEY=medcorpus-super-secret-jwt-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite by default, or PostgreSQL: postgresql+asyncpg://user:pass@localhost/medcorpus)
DATABASE_URL=sqlite+aiosqlite:///./medcorpus.db

# Optional AI Providers (System operates with rich built-in grounded medical engine if keys are absent)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
